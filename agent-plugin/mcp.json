{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "nourish": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "wellness-nourish@0.9.0"
      ],
      "cwd": "${PLUGIN_DATA}",
      "env": {
        "FDC_API_KEY": "${FDC_API_KEY}",
        "USDA_FDC_API_KEY": "${USDA_FDC_API_KEY}"
      }
    }
  }
}
